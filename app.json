{
  "expo": {
    "name": "OpenSeason",
    "slug": "openseason",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "openseason",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openseason.app",
      "usesAppleSignIn": true,
      "appleTeamId": "V6ZY6RXFTP",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.openseason.shared"]
      },
      "buildNumber": "4"
    },
    "android": {
      "package": "com.openseason.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D14"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E0794A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D14",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6aa724d9-bcc5-4f93-aded-b00c316c392c"
      }
    },
    "owner": "dgarner925",
    "updates": {
      "url": "https://u.expo.dev/6aa724d9-bcc5-4f93-aded-b00c316c392c"
    }
  }
}
