{
  "expo": {
    "name": "Open Season",
    "slug": "openseason",
    "version": "1.3.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "openseason",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#100e0c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.openseason.app",
      "usesAppleSignIn": true,
      "appleTeamId": "V6ZY6RXFTP",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.openseason.shared"
        ]
      },
      "buildNumber": "59"
    },
    "android": {
      "package": "com.osdatesanddraws.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#100e0c"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#d99e7f"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100e0c",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Open Season adds your openers and tag deadlines to your calendar when you tap Add to Calendar."
        }
      ],
      "expo-status-bar",
      "expo-font",
      "@bacons/apple-targets",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.82659984820-sapcn4c71tocngfevm1pafkrqtrqv8e7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Open Season uses your location to compute today's legal shooting light where you stand. Your location never leaves this phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6aa724d9-bcc5-4f93-aded-b00c316c392c"
      }
    },
    "owner": "dgarner925",
    "updates": {
      "url": "https://u.expo.dev/6aa724d9-bcc5-4f93-aded-b00c316c392c"
    }
  }
}
