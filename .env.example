# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to the app bundle.
# The publishable/anon key is safe to ship in a client — RLS is what protects data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Newer projects: the "publishable" key (sb_publishable_...). Older projects: the
# JWT "anon public" key. Either works — do NOT use the secret/service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Google OAuth (Supabase Auth -> Providers -> Google). Web client ID is used by
# expo-auth-session on native via Supabase's OAuth flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- Server-side only. NEVER prefix with EXPO_PUBLIC_. Set these as Supabase
# --- Edge Function / project secrets, not in the app bundle.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
